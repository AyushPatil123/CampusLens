# Compose deployment settings. Copy to .env at the repository root.
CAMPUSLENS_AUTH_USERNAME=demo
# Generate a unique random password of at least 16 characters before starting.
CAMPUSLENS_AUTH_PASSWORD=
CAMPUSLENS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-3.8-flash
CAMPUSLENS_REQUESTS_PER_MINUTE=10
CAMPUSLENS_PORT=8080

# Choose gemini or openai. Add only the key for the selected provider.
CAMPUSLENS_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_ANSWER_MODEL=gemini-3.8-flash
# For OpenAI instead, set CAMPUSLENS_PROVIDER=openai and OPENAI_API_KEY.
# OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-4.1-mini
CAMPUSLENS_DB=./data/campuslens.sqlite3
CAMPUSLENS_CHUNK_SIZE=900
CAMPUSLENS_CHUNK_OVERLAP=120
CAMPUSLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local mode is for loopback development. Public mode fails without credentials.
CAMPUSLENS_MODE=local
CAMPUSLENS_AUTH_USERNAME=
CAMPUSLENS_AUTH_PASSWORD=
CAMPUSLENS_REQUESTS_PER_MINUTE=10
# Optional OCR for pages without extractable text. Requires the ocr extra and Tesseract.
CAMPUSLENS_OCR_ENABLED=false
CAMPUSLENS_OCR_LANGUAGE=eng
CAMPUSLENS_OCR_COMMAND=tesseract
CAMPUSLENS_OCR_MAX_PAGES=10
CAMPUSLENS_OCR_TIMEOUT_SECONDS=10

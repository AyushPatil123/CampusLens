# Choose gemini or openai. Add only the key for the selected provider.
CAMPUSLENS_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_ANSWER_MODEL=gemini-3.8-flash
# For OpenAI instead, set CAMPUSLENS_PROVIDER=openai and OPENAI_API_KEY.
# OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-4.1-mini
CAMPUSLENS_DB=./data/campuslens.sqlite3
CAMPUSLENS_CHUNK_SIZE=900
CAMPUSLENS_CHUNK_OVERLAP=120
CAMPUSLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
